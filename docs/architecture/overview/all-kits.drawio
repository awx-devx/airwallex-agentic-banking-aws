ngTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="55.0" y="583.0" width="480" height="214" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Kit 1: Adaptive Treasury Controller&lt;/b&gt;&lt;br&gt;Writes quotes, conversions, transfers" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65.0" y="617.0" width="226" height="82" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Kit 2: Intent-Bound Purchase Agent&lt;/b&gt;&lt;br&gt;Writes cards and card controls" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="299.0" y="617.0" width="226" height="82" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;Kit 3: Payment Ops Incident Commander&lt;/b&gt;&lt;br&gt;Writes one replacement transfer" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="65.0" y="707.0" width="226" height="82" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Kit 4: Dispute Response Agent&lt;/b&gt;&lt;br&gt;Writes evidence, challenges, acceptances" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="299.0" y="707.0" width="226" height="82" as="geometry"/></mxCell><mxCell id="n18" value="Kits 5 to 8: customers' connected accounts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTo