yle="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="820.0" y="220.0" width="440" height="62" as="geometry"/></mxCell><mxCell id="n7" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="122.0" y="392.0" width="56" height="56" as="geometry"/></mxCell><mxCell id="t8" value="Amazon Bedrock model (Claude Sonnet)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;fontSize=14;" vertex="1" parent="1"><mxGeometry x="35.0" y="450.0" width="230" height="62" as="geometry"/></mxCell><mxCell id="n9" value="Amazon Bedrock AgentCore Runtime: the agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=14;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="340.0" y="378.0" width="180" height="84" as="geometry"/></mxCell><mxCell id="n10" value="AgentCore Gateway: one target per kit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=14;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="940.0" y="378.0" width="200" height="84" as="geometry"/></mxCell><mxCell id="n11" value="Kits 1 to 4: the platform's own account" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="40.0" y="566.0" width="600" height="300" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Kit 1: Adaptive Treasury Controller&lt;/b&gt;&lt;br&gt;Airwallex writes: foreign exchange quotes, conversions, transfers and simulated transfer transitions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50.0" y="600.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;Kit 2: Intent-Bound Purchase Agent&lt;/b&gt;&lt;br&gt;Airwallex writes: cardholders, cards, card updates and simulated authorisations" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="344.0" y="600.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;Kit 3: Payment Ops Incident Commander&lt;/b&gt;&lt;br&gt;Airwallex writes: one replacement transfer and simulated transfer transitions" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="50.0" y="732.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;Kit 4: Dispute Response Agent&lt;/b&gt;&lt;br&gt;Airwallex writes: evidence files, dispute challenges and acceptances" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="344.0" y="732.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="n16" value="Kits 5 to 8: customers' connected accounts" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#545B64;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontSize=14;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="820.0" y="566.0" width="600" height="300" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;Kit 5: Platform Spend Controller&lt;/b&gt;&lt;br&gt;Airwallex writes: cardholders, cards, simulated card spend, bridge transfers and charges" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="830.0" y="600.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Kit 6: Multi-Employer Payroll Executor&lt;/b&gt;&lt;br&gt;Airwallex writes: beneficiaries, quotes, conversions, payouts, simulated transfer transitions and the platform fee" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1124.0" y="600.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Kit 7: Portfolio Lending Agent&lt;/b&gt;&lt;br&gt;Airwallex writes: repayment charges, advance transfers and a balance report request" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="830.0" y="732.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;Kit 8: Marketplace Settlement Agent&lt;/b&gt;&lt;br&gt;Airwallex writes: seller payouts and recovery charges" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E7157B;verticalAlign=middle;align=left;spacingLeft=8;spacingRight=4;fontSize=14;fontColor=#232F3E;" vertex="1" parent="1"><mxGeometry x="1124.0" y="732.0" width="286" height="124" as="geometry"/></mxCell><mxCell id="n21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;re