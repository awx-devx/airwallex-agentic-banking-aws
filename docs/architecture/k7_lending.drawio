<mxfile host="generate.py" type="device"><diagram id="k7_lending" name="k7_lending"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t51" value="&lt;b&gt;Kit 7 Portfolio Lending Agent: code computes every repayment and tranche&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontSize=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1890" height="34" as="geometry"/></mxCell><mxCell id="g52" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#7D8998;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#7D8998;" vertex="1" parent="1"><mxGeometry x="20" y="88" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g53" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="20" y="293" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g54" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDEBF3;strokeColor=#E7157B;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g55" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="703" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g56" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1440" y="88" width="470" height="892" as="geometry"/></mxCell><mxCell id="t57" value="&lt;b&gt;Flow&lt;/b&gt;&lt;ol style='margin:1px 0 5px 0;padding-left:20px'&gt;&lt;li&gt;Sign in to the Cognito user pool (the pre-token Lambda adds the tenant claim)&lt;/li&gt;&lt;li&gt;Chat: the CLI calls AgentCore Runtime directly with the access token (Runtime JWT auth)&lt;/li&gt;&lt;li&gt;The agent calls the Bedrock model&lt;/li&gt;&lt;li&gt;The agent calls tools through AgentCore Gateway with the same token&lt;/li&gt;&lt;li&gt;The Gateway REQUEST interceptor verifies the caller and writes it into the tool call&lt;/li&gt;&lt;li&gt;The Gateway invokes the kit's tool Lambda (one Gateway target per kit)&lt;/li&gt;&lt;li&gt;A read tool invokes the kit's reader Lambda&lt;/li&gt;&lt;li&gt;The reader sends the GET to Airwallex&lt;/li&gt;&lt;li&gt;A propose tool starts the action's state machine&lt;/li&gt;&lt;li&gt;Each phase runs in the kit-step Lambda: validate, policy, build, finality check, postcondition&lt;/li&gt;&lt;li&gt;The kit-step Lambda writes the proposal, ledger and audit rows&lt;/li&gt;&lt;li&gt;An approver decides with awxpoc approve or awxpoc reject&lt;/li&gt;&lt;li&gt;The approval API invokes the approval Lambda&lt;/li&gt;&lt;li&gt;It binds the decision to the proposal hash and sends the task token&lt;/li&gt;&lt;li&gt;Each operation goes to the mutation adapter Lambda&lt;/li&gt;&lt;li&gt;The adapter writes the operation record before it sends&lt;/li&gt;&lt;li&gt;It reads the Airwallex credentials&lt;/li&gt;&lt;li&gt;It sends the write and returns the reply&lt;/li&gt;&lt;li&gt;&lt;font face='monospace'&gt;awx-deploy trigger&lt;/font&gt; starts collect_weekly_repayment or reconcile_portfolio (the scheduled runs)&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;Tools&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;Read: read_borrower_position, read_weekly_collection_preview, read_portfolio_position&lt;/li&gt;&lt;li&gt;Propose: propose_collect_weekly_repayment, propose_disburse_advance, propose_reconcile_portfolio&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;State machines and what they write&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;awx-k7-collect_weekly_repayment: charge, POST /api/v1/charges/create&lt;/li&gt;&lt;li&gt;awx-k7-disburse_advance: transfer, POST /api/v1/connected_account_transfers/create&lt;/li&gt;&lt;li&gt;awx-k7-reconcile_portfolio: report, POST /api/v1/platform_reports/create&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Approvers&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;disburse_advance moves lender money, so the kit 7 operator's approver decides every tranche (two above the threshold)&lt;/li&gt;&lt;li&gt;collect_weekly_repayment is approved in the borrower's tenant; it runs AUTO only when the schedule starts it; reconcile_portfolio may run AUTO&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Tenancy:&lt;/b&gt; each borrower is a connected account; loans enter the book through operator commands with fixed terms.&lt;br&gt;&lt;br&gt;&lt;b&gt;Model owns:&lt;/b&gt; picks a loan and an ISO week, reads positions and explains them; never an amount.&lt;br&gt;&lt;b&gt;Code owns:&lt;/b&gt; the repayment formula, rounding, arrears, reserve floor, tranche sizing, ledger postings, approval tier, tenant binding and reconciliation.&lt;br&gt;&lt;br&gt;&lt;b&gt;Acceptance test:&lt;/b&gt; make the reserve floor bind and underpay one borrower: the third disbursement shrinks so platform cash stays above the floor, a collection replay is rejected, approval tampering fails closed, and the ledger reconciles to settled movements.&lt;br&gt;&lt;br&gt;&lt;b&gt;Code locations&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;&lt;font face='monospace'&gt;kits/k7_lending/&lt;/font&gt;: workflow specs, tools, reads, policy, ledger, tests&lt;/li&gt;&lt;li&gt;Stack AwxKitK7: the generic KitStack built from the kit's manifest&lt;/li&gt;&lt;li&gt;Tool Lambda: Gateway target k7 in AwxAgentStack&lt;/li&gt;&lt;li&gt;&lt;font face='monospace'&gt;deploy/k7.yaml&lt;/font&gt;: tenants rows and operator commands&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1452" y="96" width="446" height="876" as="geometry"/></mxCell><mxCell id="n1" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="96.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t2" value="Requester or approver using the awxpoc CLI" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="296.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t4" value="Amazon Cognito user pool (requester and approver groups)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="696.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t6" value="Approval API: Amazon API Gateway HTTP API, Cognito JWT authorizer" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n7" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="96.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t8" value="Amazon Bedrock model (Claude Sonnet, with a fallback)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n9" value="Amazon Bedrock AgentCore Runtime: Strands agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="245.0" y="357.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n10" value="AgentCore Gateway (MCP, Cognito JWT inbound)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="445.0" y="357.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n11" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="696.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t12" value="Gateway REQUEST interceptor Lambda: verifies the caller" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n13" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="896.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t14" value="Kit 7 tool Lambda: read and propose tools" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n15" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="296.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t16" value="Kit 7 kit-step Lambdas: validate, policy, build, postcondition" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="496.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t18" value="Machines: collect repayment, disburse advance, reconcile" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="438.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="696.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t20" value="Approval Lambda: borrower approver, or kit 7 operator for a disbursement" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1096.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t22" value="Kit 7 reader Lambda: GET only, kit 7 allowlist" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n23" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="696.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t24" value="Shared DynamoDB: loan subledger, portfolio, proposals, operations" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n25" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="896.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t26" value="Adapter: repayment charges, disbursements, platform report" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n27" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1096.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t28" value="AWS Secrets Manager: Airwallex client credentials" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n29" value="Airwallex sandbox: platform calls naming borrower accounts" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="1245.0" y="767.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n48" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1296.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t49" value="Operator using awx-deploy trigger" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1238.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="e30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#23