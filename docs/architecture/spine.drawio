<mxfile host="generate.py" type="device"><diagram id="spine" name="spine"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t60" value="&lt;b&gt;Shared spine: the agent reads and proposes, only a Step Functions workflow moves money&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontSize=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1890" height="34" as="geometry"/></mxCell><mxCell id="g61" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#7D8998;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#7D8998;" vertex="1" parent="1"><mxGeometry x="20" y="88" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g62" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="20" y="293" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g63" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDEBF3;strokeColor=#E7157B;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g64" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="703" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g65" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1440" y="88" width="470" height="892" as="geometry"/></mxCell><mxCell id="t66" value="&lt;b&gt;Flow&lt;/b&gt;&lt;ol style='margin:1px 0 5px 0;padding-left:20px'&gt;&lt;li&gt;Sign in to the Cognito user pool (the pre-token Lambda adds the tenant claim)&lt;/li&gt;&lt;li&gt;Chat: the CLI calls AgentCore Runtime directly with the access token (Runtime JWT auth)&lt;/li&gt;&lt;li&gt;The agent calls the Bedrock model&lt;/li&gt;&lt;li&gt;The agent calls tools through AgentCore Gateway with the same token&lt;/li&gt;&lt;li&gt;The Gateway REQUEST interceptor verifies the caller and writes it into the tool call&lt;/li&gt;&lt;li&gt;The Gateway invokes the kit's tool Lambda (one Gateway target per kit)&lt;/li&gt;&lt;li&gt;A read tool invokes the kit's own reader Lambda&lt;/li&gt;&lt;li&gt;The reader sends the GET to Airwallex with the secret it holds. Tools also read the kit's ledger rows and the shared proposals and tenants tables, and write nothing&lt;/li&gt;&lt;li&gt;A propose tool starts the kit's state machine with the canonical intent&lt;/li&gt;&lt;li&gt;The machine runs each phase in the kit-step Lambda: validate, policy (code computes every amount and the risk tier), builds, finality checks, postcondition, audit&lt;/li&gt;&lt;li&gt;Policy and finality reads go through the same reader&lt;/li&gt;&lt;li&gt;The kit-step Lambda writes the proposal, ledger and audit rows&lt;/li&gt;&lt;li&gt;If a person must approve, the machine waits (waitForTaskToken). The approver lists and decides with &lt;font face='monospace'&gt;awxpoc proposals&lt;/font&gt; and &lt;font face='monospace'&gt;awxpoc approve&lt;/font&gt;&lt;/li&gt;&lt;li&gt;The approval API invokes the approval Lambda&lt;/li&gt;&lt;li&gt;It refuses the proposer and a stale or wrong proposal hash, then stores the decision&lt;/li&gt;&lt;li&gt;It sends the task token back to the waiting execution&lt;/li&gt;&lt;li&gt;Each operation goes to the adapter Lambda&lt;/li&gt;&lt;li&gt;The adapter writes the operation record before it sends (reconcile before any resend)&lt;/li&gt;&lt;li&gt;It reads the Airwallex credentials from Secrets Manager&lt;/li&gt;&lt;li&gt;It sends the write. Customer-scope operations in kits 5 and 6 carry x-on-behalf-of; platform charges and connected-account transfers name the connected account in the body&lt;/li&gt;&lt;li&gt;For a file upload it reads the evidence bytes from S3 (kit 4)&lt;/li&gt;&lt;li&gt;&lt;font face='monospace'&gt;awx-deploy trigger&lt;/font&gt; starts a schedule-driven action. &lt;font face='monospace'&gt;awx-deploy&lt;/font&gt; also writes tenants rows and runs operator commands&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;Model owns:&lt;/b&gt; reading, extracting, comparing, explaining, choosing which proposal to make.&lt;br&gt;&lt;b&gt;Code owns:&lt;/b&gt; every amount, fee, limit, tenant and connected account, approval tier, request id, finality decision and Airwallex call.&lt;br&gt;&lt;br&gt;&lt;b&gt;Schedules:&lt;/b&gt; The deployment has no Amazon EventBridge schedules. An operator starts scheduled actions with &lt;font face='monospace'&gt;awx-deploy trigger&lt;/font&gt;. In production, Amazon EventBridge Scheduler would start the same machines (not deployed).&lt;br&gt;&lt;br&gt;&lt;b&gt;Acceptance checks&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;The Runtime and tool roles cannot invoke the adapter or read the Airwallex secret&lt;/li&gt;&lt;li&gt;An approver cannot approve their own proposal, and a decision must carry the reviewed proposal hash&lt;/li&gt;&lt;li&gt;A send that may have landed is read back before any resend&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Code locations&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;&lt;font face='monospace'&gt;packages/awx_agent&lt;/font&gt;: agent, tool and interceptor handlers, awxpoc CLI&lt;/li&gt;&lt;li&gt;&lt;font face='monospace'&gt;packages/awx_spine_aws&lt;/font&gt;: adapter, reader, approval and kit-step handlers, workflow engine, awx-deploy&lt;/li&gt;&lt;li&gt;&lt;font face='monospace'&gt;packages/awx_spine&lt;/font&gt;: Airwallex client, mutation executor, endpoint table&lt;/li&gt;&lt;li&gt;&lt;font face='monospace'&gt;infra/&lt;/font&gt;: AwxSpine, KitStack, AwxAgentStack&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1452" y="96" width="446" height="876" as="geometry"/></mxCell><mxCell id="n1" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="96.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t2" value="Requester or approver using the awxpoc CLI" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="296.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t4" value="Amazon Cognito user pool (requester and approver groups)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="696.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t6" value="Approval API: Amazon API Gateway HTTP API, Cognito JWT authorizer" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n7" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="96.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t8" value="Amazon Bedrock model (Claude Sonnet, with a fallback)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n9" value="Amazon Bedrock AgentCore Runtime: Strands agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="245.0" y="357.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n10" value="AgentCore Gateway (MCP, Cognito JWT inbound)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="445.0" y="357.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n11" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="696.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t12" value="Gateway REQUEST interceptor Lambda: verifies the caller" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n13" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="896.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t14" value="Tool Lambda per kit: read_* and propose_* (Gateway target)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n15" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="296.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t16" value="Kit-step Lambda per action: validate, policy, build, postcondition" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="496.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t18" value="AWS Step Functions Standard: awx-&amp;lt;kit&amp;gt;-&amp;lt;action&amp;gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="438.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="696.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t20" value="Approval Lambda: checks the decision, sends the task token" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1096.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t22" value="Reader Lambda per kit: GET only, per-kit allowlist" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n23" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1"><mxGeometry x="96.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t24" value="Amazon CloudWatch alarms to an Amazon SNS topic; AWS Budgets alarm" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n25" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.key_management_service;" vertex="1" parent="1"><mxGeometry x="296.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t26" value="AWS KMS customer managed key (tables, bucket, secret)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n27" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="496.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t28" value="Amazon S3 artifacts bucket: evidence/" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="438.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n29" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="696.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t30" value="DynamoDB tables: operations, proposals, decisions, tenants, ledger, audit" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n31" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="896.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t32" value="Mutation adapter Lambda: the only Airwallex writer" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n33" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1096.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t34" value="AWS Secrets Manager: Airwallex client credentials" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n35" value="Airwallex sandbox API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="1245.0" y="767.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n36" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1296.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t37" value="Operator using awx-deploy" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1238.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="e38" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;e