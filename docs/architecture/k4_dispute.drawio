<mxfile host="generate.py" type="device"><diagram id="k4_dispute" name="k4_dispute"><mxGraphModel dx="1600" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1930" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="t58" value="&lt;b&gt;Kit 4 Dispute Response Agent: evidence, economics and a deadline decide the response&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontSize=18;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="14" width="1890" height="34" as="geometry"/></mxCell><mxCell id="g59" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#F5F5F5;strokeColor=#7D8998;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#7D8998;" vertex="1" parent="1"><mxGeometry x="20" y="88" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g60" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#01A88D;" vertex="1" parent="1"><mxGeometry x="20" y="293" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g61" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FDEBF3;strokeColor=#E7157B;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#E7157B;" vertex="1" parent="1"><mxGeometry x="20" y="498" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g62" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFF3E6;strokeColor=#ED7100;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#ED7100;" vertex="1" parent="1"><mxGeometry x="20" y="703" width="1400" height="186" as="geometry"/></mxCell><mxCell id="g63" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=12;fontStyle=1;fontColor=#545B64;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="1440" y="88" width="470" height="892" as="geometry"/></mxCell><mxCell id="t64" value="&lt;b&gt;Flow&lt;/b&gt;&lt;ol style='margin:1px 0 5px 0;padding-left:20px'&gt;&lt;li&gt;Sign in to the Cognito user pool (the pre-token Lambda adds the tenant claim)&lt;/li&gt;&lt;li&gt;Chat: the CLI calls AgentCore Runtime directly with the access token (Runtime JWT auth)&lt;/li&gt;&lt;li&gt;The agent calls the Bedrock model&lt;/li&gt;&lt;li&gt;The agent calls tools through AgentCore Gateway with the same token&lt;/li&gt;&lt;li&gt;The Gateway REQUEST interceptor verifies the caller and writes it into the tool call&lt;/li&gt;&lt;li&gt;The Gateway invokes the kit's tool Lambda (one Gateway target per kit)&lt;/li&gt;&lt;li&gt;A read tool invokes the kit's reader Lambda&lt;/li&gt;&lt;li&gt;The reader sends the GET to Airwallex&lt;/li&gt;&lt;li&gt;A propose tool starts the action's state machine&lt;/li&gt;&lt;li&gt;Each phase runs in the kit-step Lambda: validate, policy, build, finality check, postcondition&lt;/li&gt;&lt;li&gt;The kit-step Lambda writes the proposal, ledger and audit rows&lt;/li&gt;&lt;li&gt;An approver decides with awxpoc approve or awxpoc reject&lt;/li&gt;&lt;li&gt;The approval API invokes the approval Lambda&lt;/li&gt;&lt;li&gt;It binds the decision to the proposal hash and sends the task token&lt;/li&gt;&lt;li&gt;Each operation goes to the mutation adapter Lambda&lt;/li&gt;&lt;li&gt;The adapter writes the operation record before it sends&lt;/li&gt;&lt;li&gt;It reads the Airwallex credentials&lt;/li&gt;&lt;li&gt;It sends the write and returns the reply&lt;/li&gt;&lt;li&gt;An operator invokes the evidence upload Lambda with one JPG or PDF&lt;/li&gt;&lt;li&gt;It writes the bytes under &lt;font face='monospace'&gt;evidence/k4/&amp;lt;tenant&amp;gt;/&lt;/font&gt;&lt;/li&gt;&lt;li&gt;It writes the evidence index to the kit's ledger&lt;/li&gt;&lt;li&gt;For files.upload the adapter reads the evidence bytes&lt;/li&gt;&lt;/ol&gt;&lt;b&gt;Tools&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;Read: read_dispute_queue, read_dispute, read_dispute_economics, read_refunds&lt;/li&gt;&lt;li&gt;Propose: propose_accept_dispute, propose_challenge_dispute, propose_refer_dispute, propose_clear_dispute_response, propose_close_dispute&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;State machines and what they write&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;awx-k4-challenge_dispute: upload_evidence, POST /api/v1/files/upload; submit_challenge, POST /api/v1/pa/payment_disputes/{id}/challenge&lt;/li&gt;&lt;li&gt;awx-k4-accept_dispute: accept, POST /api/v1/pa/payment_disputes/{id}/accept&lt;/li&gt;&lt;li&gt;awx-k4-refer_dispute, awx-k4-close_dispute, awx-k4-clear_dispute_response: record a referral, outcome or clearance; send nothing&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Approvers&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;accept, challenge and clear_dispute_response need one approver of the platform tenant; refer and close may run AUTO&lt;/li&gt;&lt;li&gt;A proposer cannot approve their own accept&lt;/li&gt;&lt;/ul&gt;&lt;b&gt;Tenancy:&lt;/b&gt; one Airwallex platform account. No x-on-behalf-of header; tenancy is the platform's own tenant.&lt;br&gt;&lt;br&gt;&lt;b&gt;Model owns:&lt;/b&gt; reads JPG and PDF evidence, returns typed facts citing an evidence id and an exact quote, writes the narrative for the approver.&lt;br&gt;&lt;b&gt;Code owns:&lt;/b&gt; the evidence index (type from magic bytes, size, hash), citation checks, economics, deadline, approval tier, case state and request ids.&lt;br&gt;&lt;br&gt;&lt;b&gt;Acceptance test:&lt;/b&gt; the strong fraud case is challenged with JPG and PDF evidence, resolves to rejection, records the fee and outcome, and sends no second challenge; the small case cannot be accepted without the bound approval.&lt;br&gt;&lt;br&gt;&lt;b&gt;Code locations&lt;/b&gt;&lt;ul style='margin:1px 0 5px 0;padding-left:16px'&gt;&lt;li&gt;&lt;font face='monospace'&gt;kits/k4_dispute/&lt;/font&gt;: workflow specs, tools, reads, policy, ledger, tests&lt;/li&gt;&lt;li&gt;Stack AwxKitK4: the generic KitStack built from the kit's manifest&lt;/li&gt;&lt;li&gt;Tool Lambda: Gateway target k4 in AwxAgentStack&lt;/li&gt;&lt;li&gt;Evidence upload Lambda: declared in the kit's FUNCTIONS, built by KitStack&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1452" y="96" width="446" height="876" as="geometry"/></mxCell><mxCell id="n1" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="96.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t2" value="Requester or approver using the awxpoc CLI" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n3" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cognito;" vertex="1" parent="1"><mxGeometry x="296.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t4" value="Amazon Cognito user pool (requester and approver groups)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n5" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.api_gateway;" vertex="1" parent="1"><mxGeometry x="696.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t6" value="Approval API: Amazon API Gateway HTTP API, Cognito JWT authorizer" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n7" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#01A88D;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.bedrock;" vertex="1" parent="1"><mxGeometry x="96.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t8" value="Amazon Bedrock model (Claude Sonnet, with a fallback)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="38.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n9" value="Amazon Bedrock AgentCore Runtime: Strands agent" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="245.0" y="357.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n10" value="AgentCore Gateway (MCP, Cognito JWT inbound)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F6F4;strokeColor=#01A88D;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="445.0" y="357.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n11" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="696.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t12" value="Gateway REQUEST interceptor Lambda: verifies the caller" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n13" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="896.0" y="361.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t14" value="Kit 4 tool Lambda: read and propose tools" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.0" y="411.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n15" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="296.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t16" value="Kit 4 kit-step Lambdas: validate, policy, build, postcondition" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="238.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n17" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.step_functions;" vertex="1" parent="1"><mxGeometry x="496.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t18" value="Machines: accept, challenge, refer, close, clear_dispute_response" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="438.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n19" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="696.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t20" value="Approval Lambda: records a platform-tenant approver's decision" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n21" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1096.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t22" value="Kit 4 reader Lambda: GET only, kit 4 allowlist" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n23" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#7AA116;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.s3;" vertex="1" parent="1"><mxGeometry x="496.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t24" value="Amazon S3: evidence/k4/&amp;lt;tenant&amp;gt;/ (JPG and PDF)" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="438.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n25" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#C925D1;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.dynamodb;" vertex="1" parent="1"><mxGeometry x="696.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t26" value="Shared DynamoDB: case state, evidence index, proposals, operations" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="638.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n27" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="896.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t28" value="Adapter: evidence upload, challenge, accept" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="838.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n29" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#DD344C;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1"><mxGeometry x="1096.0" y="771.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t30" value="AWS Secrets Manager: Airwallex client credentials" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1038.0" y="821.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n31" value="Airwallex sandbox API (platform account)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#232F3E;strokeWidth=2;fontSize=11;fontColor=#232F3E;spacing=4;" vertex="1" parent="1"><mxGeometry x="1245.0" y="767.0" width="150" height="56" as="geometry"/></mxCell><mxCell id="n50" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#232F3E;strokeColor=none;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.user;" vertex="1" parent="1"><mxGeometry x="1296.0" y="156.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t51" value="Operator" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1238.0" y="206.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="n52" value="" style="sketch=0;outlineConnect=0;fontColor=#232F3E;fillColor=#ED7100;strokeColor=#ffffff;dashed=0;html=1;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.lambda;" vertex="1" parent="1"><mxGeometry x="1296.0" y="566.0" width="48" height="48" as="geometry"/></mxCell><mxCell id="t53" value="Evidence upload Lambda: types, hashes and indexes a file" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=11;align=center;verticalAlign=top;spacing=0;" vertex="1" parent="1"><mxGeometry x="1238.0" y="616.0" width="164" height="46" as="geometry"/></mxCell><mxCell id="e32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;exitX=1;exitY=0.5;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="e33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=1.5;strokeColor=#232F3E;exitX=1;exitY=0.2;entryX=0;entryY=0.5;exitDx=0;exitDy=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="n1" target="n9"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="208" y="165.6"/><mxPoint x="208" y="385.0"/></Array></mxGeometry></mxCell>